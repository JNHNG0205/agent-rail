# ── Copy to .env and fill in. Never commit the real .env. ──

# ─── chain: local (default for dev + demo) ───
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337

# Hardhat default accounts — LOCAL ONLY.
# These private keys are published in Hardhat's docs and are known to everyone.
# Sending real or testnet funds to them means losing the funds to sweeper bots.
#
# Hardhat account #0 is the deployer and is NOT an agent. It owns JobContract and
# ReputationRegistry, and an owner can re-point the identity registry, the
# evaluator module and the reputation registry — so an agent holding it could
# rewrite the rules that constrain it. The deployer needs no key here: scripts
# read it from Hardhat's own account list (and from
# BASE_SEPOLIA_DEPLOYER_PRIVATE_KEY on testnet).
#
# Agents are accounts #1-#3.
AGENT_A_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d
AGENT_B_PRIVATE_KEY=0x5de4111afa1a4b94908f83103eb1f1706367c2e68ca870fc3fb9a804cdab365a
AGENT_C_PRIVATE_KEY=0x7c852118294e51e653712a81e05800f419141751be58f605c371e15141b007a6

# Agent A names the evaluator on each job (the client chooses it, per ACP).
# Only the address is needed — Agent A must never hold Agent C's key.
EVALUATOR_ADDRESS=0x90F79bf6EB2c4f870365E785982E1f101E93b906

# ─── chain: Base Sepolia (opt-in, `--network baseSepolia`) ───
# Leave blank unless deploying to testnet. Generate FRESH keypairs — never reuse
# the Hardhat keys above.
#
# All four need testnet ETH for gas. They do NOT need real testnet USDC: the
# demo uses its own MockUSDC with an open mint(), which seed.ts calls.
#
# The deployer is a fourth keypair, not Agent A — see the note above. It sends by
# far the most transactions (5 deploys + 4 wiring calls + 6 seeding calls), so
# fund it most generously; the agents send about 3 each per job.
#
# Optional; defaults to https://sepolia.base.org, a shared public pool that
# rate-limits under an indexer backfill. Set your own for anything sustained.
# BASE_SEPOLIA_RPC_URL=
BASE_SEPOLIA_DEPLOYER_PRIVATE_KEY=
BASE_SEPOLIA_AGENT_A_PRIVATE_KEY=
BASE_SEPOLIA_AGENT_B_PRIVATE_KEY=
BASE_SEPOLIA_AGENT_C_PRIVATE_KEY=

# To run the agents against testnet, set CHAIN_ID=84532. The endpoint and the
# keys are both selected by chain, so lib/wallet.ts reads the
# BASE_SEPOLIA_AGENT_*_PRIVATE_KEY values and BASE_SEPOLIA_RPC_URL instead of the
# local ones — the published Hardhat keys can never reach a public chain by
# forgetting to swap a second value.

# Contract verification on Basescan (optional, nice-to-have for the report).
BASESCAN_API_KEY=

# ─── which chain the apps talk to ───
# Everything defaults to local (31337) when these are unset. To point the stack
# at Base Sepolia set CHAIN_ID=84532 and RPC_URL to the testnet endpoint.
# Next.js only exposes NEXT_PUBLIC_* to the browser, so the web app needs both.
NEXT_PUBLIC_CHAIN_ID=31337
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545

# ─── llm (OpenRouter gateway; agent-b designs the poster as SVG, agent-c independently
# evaluates it and signs the approval that settles escrow — agent-c is separate from
# agent-a so the client commissioning the work cannot grade its own job) ───
# mock is the shipped default: it skips the network entirely, so a fresh clone and demo
# day both work with zero setup. Switch to openrouter only once LLM_API_KEY and LLM_MODEL
# below are filled in with a real key and a model that supports structured output.
LLM_PROVIDER=mock
LLM_BASE_URL=https://openrouter.ai/api/v1
# Format: sk-or-v1-... — leave empty under LLM_PROVIDER=mock; required for openrouter.
LLM_API_KEY=
# Pin a model whose OpenRouter page lists structured-output support — agent-c's
# evaluation is signed and settled on-chain, so malformed JSON breaks settlement.
LLM_MODEL=

# ─── database (indexer writes, web reads via API routes) ───
DATABASE_URL=postgres://postgres:postgres@localhost:5432/agentrail

# ─── agent-b http server ───
AGENT_B_PORT=4020
AGENT_B_PRICE_USDC=10

# Postgres schema Ponder writes into. `public` keeps the web API's SQL simple;
# Ponder wants it explicit in production mode (`ponder start`).
DATABASE_SCHEMA=public

# Agent C on Base Sepolia — necessarily a different keypair from the local one.
BASE_SEPOLIA_EVALUATOR_ADDRESS=
