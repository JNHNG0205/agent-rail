# ── Copy to .env and fill in. Never commit the real .env. ──

# ─── chain: local (default for dev + demo) ───
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337

# Hardhat default accounts — LOCAL ONLY.
# These private keys are published in Hardhat's docs and are known to everyone.
# Sending real or testnet funds to them means losing the funds to sweeper bots.
AGENT_A_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
AGENT_B_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d
AGENT_C_PRIVATE_KEY=0x5de4111afa1a4b94908f83103eb1f1706367c2e68ca870fc3fb9a804cdab365a

# Agent A names the evaluator on each job (the client chooses it, per ACP).
# Only the address is needed — Agent A must never hold Agent C's key.
EVALUATOR_ADDRESS=0x3C44CdDdB6a900fa2b585dd299e03d12FA4293BC

# ─── chain: Base Sepolia (opt-in, `--network baseSepolia`) ───
# Leave blank unless deploying to testnet. Generate FRESH keypairs — never reuse
# the Hardhat keys above. Fund each from a Base Sepolia faucet.
BASE_SEPOLIA_RPC_URL=https://base-sepolia.drpc.org
BASE_SEPOLIA_DEPLOYER_PRIVATE_KEY=
BASE_SEPOLIA_AGENT_A_PRIVATE_KEY=
BASE_SEPOLIA_AGENT_B_PRIVATE_KEY=
BASE_SEPOLIA_AGENT_C_PRIVATE_KEY=

# Contract verification on Basescan (optional, nice-to-have for the report).
BASESCAN_API_KEY=

# ─── which chain the apps talk to ───
# Everything defaults to local (31337) when these are unset. To point the stack
# at Base Sepolia set CHAIN_ID=84532 and RPC_URL to the testnet endpoint.
# Next.js only exposes NEXT_PUBLIC_* to the browser, so the web app needs both.
NEXT_PUBLIC_CHAIN_ID=31337
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545

# ─── llm (OpenRouter gateway; agent-b designs the poster as SVG, agent-c independently
# evaluates it and signs the approval that settles escrow — agent-c is separate from
# agent-a so the client commissioning the work cannot grade its own job) ───
# mock is the shipped default: it skips the network entirely, so a fresh clone and demo
# day both work with zero setup. Switch to openrouter only once LLM_API_KEY and LLM_MODEL
# below are filled in with a real key and a model that supports structured output.
LLM_PROVIDER=mock
LLM_BASE_URL=https://openrouter.ai/api/v1
# Format: sk-or-v1-... — leave empty under LLM_PROVIDER=mock; required for openrouter.
LLM_API_KEY=
# Pin a model whose OpenRouter page lists structured-output support — agent-c's
# evaluation is signed and settled on-chain, so malformed JSON breaks settlement.
LLM_MODEL=

# ─── database (indexer writes, web reads via API routes) ───
DATABASE_URL=postgres://postgres:postgres@localhost:5432/agentrail

# ─── agent-b http server ───
AGENT_B_PORT=4020
AGENT_B_PRICE_USDC=10
