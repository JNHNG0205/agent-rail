# ── Copy to .env and fill in. Never commit the real .env. ──

# chain
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337

# agents (Hardhat default accounts — safe for LOCAL ONLY, never fund on real networks)
AGENT_A_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
AGENT_B_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d

# llm (agent-b task execution)
