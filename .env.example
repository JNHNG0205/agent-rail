# ── Copy to .env and fill in. Never commit the real .env. ──
#
# This file is read ONLY by packages/contracts/hardhat.config.ts (deploy, seed,
# verify) and scripts/preflight.ts. Nothing else loads it.
#
# Every other package reads its own file, and only its own:
#
#   packages/agents/.env         <- packages/agents/.env.example
#   packages/indexer/.env.local  <- packages/indexer/.env.local.example
#                                   (Ponder reads .env.local, NOT .env)
#   packages/web/.env            <- packages/web/.env.example
#
# Set each variable where it is read. Copies kept here are simply ignored, so a
# setting changed in this file appears to take effect and does not — this file
# previously carried the LLM, database and agent settings as well, and editing
# them here did nothing at all.
#
# Nothing below is needed to run locally: `npm run dev` boots a Hardhat node with
# its own accounts. Fill this in only to deploy to or run against Base Sepolia.

# ─── Base Sepolia ───

# Private endpoint (Alchemy, QuickNode, …). The public pool at
# https://sepolia.base.org is load balanced, so it answers reads from nodes that
# have not caught up — stale state, missing blocks and reused nonces — and it
# rate-limits the indexer's historical backfill.
BASE_SEPOLIA_RPC_URL=

# Contract verification on Basescan. Supply a single key: that routes through the
# Etherscan V2 API, which covers every chain from one endpoint. The per-network
# form ({ baseSepolia: ... }) selects the retired V1 API and every request fails.
# Verification also works with no key at all, through Blockscout.
BASESCAN_API_KEY=

# Four accounts, and the order is load bearing — it mirrors the local chain,
# where Hardhat account #0 deploys and #1-#3 are the agents.
#
# The deployer is deliberately NOT one of the agents. It owns JobContract and
# ReputationRegistry, and an owner can re-point the identity registry, the
# evaluator module and the reputation registry. An agent holding it could rewrite
# the rules constraining its own job.
#
# Generate fresh keypairs — never reuse Hardhat's published ones, which are
# swept within seconds on a public chain. All four need testnet ETH for gas; they
# do not need real testnet USDC, because the demo mints its own MockUSDC.
BASE_SEPOLIA_DEPLOYER_PRIVATE_KEY=
BASE_SEPOLIA_AGENT_A_PRIVATE_KEY=
BASE_SEPOLIA_AGENT_B_PRIVATE_KEY=
BASE_SEPOLIA_AGENT_C_PRIVATE_KEY=
