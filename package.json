{
  "name": "agent-rail",
  "version": "0.1.0",
  "private": true,
  "description": "Decentralised AI agent payment settlement DApp (CT124-3-3 Group 7)",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "compile": "npm -w packages/contracts run compile",
    "chain": "npm -w packages/contracts run node",
    "deploy": "npm -w packages/contracts run deploy",
    "deploy:base-sepolia": "npm -w packages/contracts run deploy:base-sepolia",
    "seed": "npm -w packages/contracts run seed",
    "seed:base-sepolia": "npm -w packages/contracts run seed:base-sepolia",
    "verify:base-sepolia": "npm -w packages/contracts run verify:base-sepolia",
    "e2e": "npm -w packages/contracts run e2e",
    "db:up": "docker compose up -d postgres",
    "db:setup": "bash scripts/db-setup.sh",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v",
    "indexer": "npm -w packages/indexer run start",
    "indexer:base-sepolia": "CHAIN_ID=84532 npm -w packages/indexer run start",
    "web": "npm -w packages/web run dev",
    "agent:c": "npm -w packages/agents run start:c",
    "runtime": "npm -w packages/agents run start:runtime",
    "runtime:base-sepolia": "CHAIN_ID=84532 npm -w packages/agents run start:runtime",
    "agent:c:base-sepolia": "CHAIN_ID=84532 npm -w packages/agents run start:c",
    "sweep:base-sepolia": "CHAIN_ID=84532 npm -w packages/agents run sweep --",
    "test": "npm test --workspaces --if-present",
    "coverage": "npm -w packages/contracts run coverage",
    "dev": "bash scripts/dev.sh",
    "dev:base-sepolia": "bash scripts/dev.sh base-sepolia",
    "demo:reset": "bash scripts/demo-reset.sh",
    "preflight:base-sepolia": "tsx scripts/preflight.ts",
    "accounts:new": "tsx scripts/new-accounts.ts"
  },
  "engines": {
    "node": ">=20"
  }
}
