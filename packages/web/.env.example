# Copy to packages/web/.env — Next.js reads .env from its own package
# directory, NOT the monorepo root, so this file is separate from the root one.

# Read by the /api/* routes (server-side only; never import lib/db.ts from a
# client component).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/agentrail

# Only NEXT_PUBLIC_* vars reach the browser. lib/viem.ts needs these to pick
# the chain; both default to local when unset.
NEXT_PUBLIC_CHAIN_ID=31337
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545

# Use the PUBLIC endpoint here, never the private one from the root .env.
# NEXT_PUBLIC_* is inlined into the JavaScript bundle served to every visitor, so
# a private URL publishes its API key to anyone who opens the page.
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# The agent runtime, reached only from this app's server side. Deliberately not
# NEXT_PUBLIC_*: the secret must never reach the browser, which is why the API
# routes proxy instead of letting the page call the runtime directly.
AGENT_RUNTIME_URL=http://127.0.0.1:4030
AGENT_RUNTIME_SECRET=

# ─── Sign-in (Privy) ───

# Both are PUBLIC identifiers and are meant to be committed. Privy puts the app
# id in the audience of every token it issues, and the client id identifies this
# app to Privy. Neither authorises anything: the server checks a token's
# signature against Privy's published key, and holding these grants nothing.
#
# There is deliberately no app secret. Verification needs only the public half,
# so the one credential that would matter if leaked is never here at all.
#
# Leave these EMPTY to run without Privy. That switches both halves of the app
# to a local identity kept in the browser — no login, no Privy account needed to
# run the demo — and the server then accepts an unverified x-agent-owner header.
# Setting the app id turns that header off. Never leave it unset on anything
# reachable by other people: without it, anyone can claim to be anyone.
NEXT_PUBLIC_PRIVY_APP_ID=cmsfo82l901x60ckz2gtxq6vd
NEXT_PUBLIC_PRIVY_CLIENT_ID=client-WY6cC7UmVKHQx3gSZRBQu4xNBwtzS4yQMoKvexAGVfHZT
