# Copy to packages/web/.env — Next.js reads .env from its own package
# directory, NOT the monorepo root, so this file is separate from the root one.

# Read by the /api/* routes (server-side only; never import lib/db.ts from a
# client component).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/agentrail

# Only NEXT_PUBLIC_* vars reach the browser. lib/viem.ts needs these to pick
# the chain; both default to local when unset.
NEXT_PUBLIC_CHAIN_ID=31337
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545

# Use the PUBLIC endpoint here, never the private one from the root .env.
# NEXT_PUBLIC_* is inlined into the JavaScript bundle served to every visitor, so
# a private URL publishes its API key to anyone who opens the page.
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
