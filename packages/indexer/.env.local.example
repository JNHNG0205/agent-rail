# Copy to packages/indexer/.env.local
#
# Ponder reads .env.local, NOT .env — unlike every other package here. Copying
# this to .env instead silently leaves DATABASE_URL unset and the indexer fails
# to connect.
#
# The Postgres schema is passed on the CLI (see the dev/start scripts), so it
# does not need to be set here.

DATABASE_URL=postgres://postgres:postgres@localhost:5432/agentrail
RPC_URL=http://127.0.0.1:8545

# Required when indexing Base Sepolia — not optional in practice. Leaving it
# unset does not fail: Ponder falls back to the public pool, logs one
# "Detected public RPC URL" warning, and then rate-limits partway through the
# historical backfill, which looks like a hang rather than a limit. Use an
# Alchemy or QuickNode endpoint.
#
# `npm run dev:base-sepolia` lifts this from the root .env for the processes it
# starts, so it only has to be set here for running the indexer on its own.
BASE_SEPOLIA_RPC_URL=
