# Copy to packages/indexer/.env.local
#
# Ponder reads .env.local, NOT .env — unlike every other package here. Copying
# this to .env instead silently leaves DATABASE_URL unset and the indexer fails
# to connect.
#
# The Postgres schema is passed on the CLI (see the dev/start scripts), so it
# does not need to be set here.

# Which chain to index. dev.sh exports this for the stack it starts, so this
# value only applies when running `npm run indexer` on its own — which is
# exactly when you are debugging and least want it guessing.
CHAIN_ID=31337

DATABASE_URL=postgres://postgres:postgres@localhost:5432/agentrail
RPC_URL=http://127.0.0.1:8545

# The indexer uses the PUBLIC Base Sepolia endpoint by default, deliberately —
# see ponder.config.ts. Its workload is bulk eth_getLogs, and the public endpoint
# serves 1000 block ranges where Alchemy's free tier caps them at 10. Over the
# deployed history that is 200 requests against 20,000, and the 20,000 exceed the
# free tier's compute units per second, so the backfill stalls with 429s.
#
# Set this only on a paid plan, where the range cap is lifted.
# BASE_SEPOLIA_INDEXER_RPC_URL=
