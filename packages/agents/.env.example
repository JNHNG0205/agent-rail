# agents
RPC_URL=http://127.0.0.1:8545

# Hardhat default accounts — LOCAL ONLY, never fund on a real network.
AGENT_A_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
AGENT_B_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d
AGENT_C_PRIVATE_KEY=0x5de4111afa1a4b94908f83103eb1f1706367c2e68ca870fc3fb9a804cdab365a

# agent-b http server
AGENT_B_PORT=4020
AGENT_B_PRICE_USDC=10
AGENT_B_URL=http://127.0.0.1:4020

# llm (OpenRouter gateway)
# LLM_PROVIDER=mock skips the network entirely — use it for demo-day reliability.
LLM_PROVIDER=openrouter
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=sk-or-v1-...
# Pin a model whose OpenRouter page lists structured-output support — agent-a's
# evaluation is signed and settled on-chain, so malformed JSON breaks settlement.
LLM_MODEL=
