# agents
RPC_URL=http://127.0.0.1:8545

# Hardhat default accounts — LOCAL ONLY, never fund on a real network.
# Accounts #1-#3. #0 is the contracts' deployer/owner and is deliberately not an
# agent, so no agent can re-point the registries that constrain it. The agents
# never need the deployer key.
AGENT_A_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d
AGENT_B_PRIVATE_KEY=0x5de4111afa1a4b94908f83103eb1f1706367c2e68ca870fc3fb9a804cdab365a
AGENT_C_PRIVATE_KEY=0x7c852118294e51e653712a81e05800f419141751be58f605c371e15141b007a6

# Agent A names the evaluator on each job (the client chooses it, per ACP).
# Only the address is needed — Agent A must never hold Agent C's key.
EVALUATOR_ADDRESS=0x90F79bf6EB2c4f870365E785982E1f101E93b906

# agent-b http server
AGENT_B_PORT=4020
AGENT_B_PRICE_USDC=10
AGENT_B_URL=http://127.0.0.1:4020

# llm (OpenRouter gateway; agent-b designs the poster as SVG, agent-c independently
# evaluates it and signs the approval that settles escrow — agent-c is separate from
# agent-a so the client commissioning the work cannot grade its own job)
# mock is the shipped default: it skips the network entirely, so a fresh clone and demo
# day both work with zero setup. Switch to openrouter only once LLM_API_KEY and LLM_MODEL
# below are filled in with a real key and a model that supports structured output.
LLM_PROVIDER=mock
LLM_BASE_URL=https://openrouter.ai/api/v1
# Format: sk-or-v1-... — leave empty under LLM_PROVIDER=mock; required for openrouter.
LLM_API_KEY=
# Pin a model whose OpenRouter page lists structured-output support — agent-c's
# evaluation is signed and settled on-chain, so malformed JSON breaks settlement.
LLM_MODEL=

# ─── testnet ───
# Uncomment CHAIN_ID and fill these in. Everything else follows from CHAIN_ID:
# the endpoint, the keys, and the evaluator are each selected by chain, so the
# Hardhat keys and the local RPC above stay local-only and cannot be paired with
# the wrong network by forgetting to change a second variable.
# CHAIN_ID=84532
# Defaults to https://sepolia.base.org, a shared public pool. That works for the
# agents but rate-limits the indexer's backfill, so set a private endpoint here
# too and keep every package pointed at the same one.
BASE_SEPOLIA_RPC_URL=
BASE_SEPOLIA_AGENT_A_PRIVATE_KEY=
BASE_SEPOLIA_AGENT_B_PRIVATE_KEY=
BASE_SEPOLIA_AGENT_C_PRIVATE_KEY=
