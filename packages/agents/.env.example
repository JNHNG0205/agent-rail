# agents

# The chain everything else follows from. The endpoint, the keys and the
# evaluator are each selected by it, so a single value moves the whole package
# between networks and the keys for one cannot be paired with the other by
# forgetting to change a second variable.
#
# 84532 is Base Sepolia, where the contracts are already deployed and verified.
CHAIN_ID=84532

# Defaults to https://sepolia.base.org, a shared public pool. That works for the
# agents but rate-limits the indexer's backfill, so set a private endpoint here
# and keep every package pointed at the same one.
BASE_SEPOLIA_RPC_URL=

# The evaluator. It signs the verdict that settles or refunds every job, so it
# is never a key any client holds — a client that could sign its own approval is
# the one thing the escrow exists to prevent.
BASE_SEPOLIA_AGENT_C_PRIVATE_KEY=

# The same account's ADDRESS, not its key. Anything creating a job has to name
# the evaluator it will accept a verdict from; giving it the key would let it
# sign that verdict itself. Without this, every hire fails with "no evaluator
# address configured".
BASE_SEPOLIA_EVALUATOR_ADDRESS=

# Funds each newly created agent's first user operation — a smart account cannot
# pay for its own deployment, so something outside it must go first. Holds
# testnet ETH and no authority: deliberately NOT the deployer, which owns the
# contracts and could re-point the registries.
BASE_SEPOLIA_TREASURY_PRIVATE_KEY=

# `npm run accounts:new` generates all three and prints them in this exact shape.

# ─── language model ───
# agent-b produces the deliverable; agent-c independently grades it and signs the
# decision that settles escrow. They are separate agents so the party that
# commissioned the work cannot grade its own job.
#
# mock is the shipped default: it skips the network entirely, so a fresh clone
# runs offline. Switch to openrouter once LLM_API_KEY and LLM_MODEL are filled in.
LLM_PROVIDER=mock
LLM_BASE_URL=https://openrouter.ai/api/v1
# Format: sk-or-v1-... — leave empty under mock; required for openrouter.
LLM_API_KEY=
# Pin a model whose OpenRouter page lists structured-output support. The JSON
# calls send a strict json_schema and set provider.require_parameters, so a model
# without it fails the request outright rather than returning prose agent-c
# cannot act on. Browse the supported set at:
#   https://openrouter.ai/models?supported_parameters=structured_outputs
# deepseek/deepseek-v4-flash and google/gemini-2.5-flash-lite are both cheap and
# verified against every call this system makes; openai/gpt-5-nano also works.
LLM_MODEL=

# ─── runtime ───
# Hosts every agent a user creates.
AGENT_RUNTIME_PORT=4030

# Agent keys live in Postgres, in their own `runtime` schema — NOT `public`,
# which Ponder owns and drops. A soulbound identity cannot be re-minted, so a
# dropped key orphans that agent permanently.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/agentrail

# Reads are open so agents can discover each other. Writes spend gas, USDC and
# model tokens, so they need this. The runtime refuses to start on a non-loopback
# host without it.
AGENT_RUNTIME_SECRET=
AGENT_RUNTIME_HOST=127.0.0.1
